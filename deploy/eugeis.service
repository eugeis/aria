[Unit]
Description=eugeis - Alexa voice front-end for ZeroClaw
After=network-online.target zeroclaw.service
Wants=network-online.target

[Service]
Type=simple
User=z000ru5y
Environment=EUGEIS_DATA_DIR=/home/z000ru5y/.eugeis
# Environment=EUGEIS_ZC_TOKEN=***
ExecStart=/home/z000ru5y/.cargo/bin/eugeis --config /home/z000ru5y/.eugeis/config.toml
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/z000ru5y/.eugeis /srv/music

[Install]
WantedBy=multi-user.target
